# Create a key at https://platform.claude.com (Settings > API keys), then copy this file to .env
ANTHROPIC_API_KEY=
# Only for organization-wide keys: the workspace to use (Settings > Workspaces, starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=
# Optional: which Claude model searches (default claude-haiku-5-5, the cheapest)
# ACCIO_MODEL=claude-sonnet-5-5
